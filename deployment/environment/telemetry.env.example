INFLUX_TELEMETRY_TOKEN=replace-with-write-token-limited-to-solar_telemetry-bucket
OUTBOX_STATE_DIRECTORY=/var/lib/solar-battery-telemetry
STATUS_DIRECTORY=/run/solar-battery-status/telemetry
SIGENERGY_HOME_APP_KEY=replace-with-read-only-developer-app-key
SIGENERGY_HOME_APP_SECRET=replace-with-read-only-developer-app-secret
SIGENERGY_HOME_SYSTEM_ID=replace-with-installation-id
# For another property, use a non-identifying, unique alias in config.yaml and add a matching set,
# for example SIGENERGY_HOME_02_APP_KEY/APP_SECRET/SYSTEM_ID. Never use an address, account number,
# serial number, or live system ID in the variable name or repository example.
