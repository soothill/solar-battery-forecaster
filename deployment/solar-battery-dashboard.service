[Unit]
Description=Solar Battery Forecaster Dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=solar-dashboard
Group=solar-dashboard
SupplementaryGroups=solar-config
WorkingDirectory=/opt/solar-battery-forecaster
EnvironmentFile=/etc/solar-battery-forecaster/dashboard.env
ExecStart=/opt/solar-battery-forecaster/.venv/bin/solar-battery-dashboard --config /etc/solar-battery-forecaster/config.yaml --host 127.0.0.1 --port 8088
Restart=on-failure
RestartSec=15
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
MemoryDenyWriteExecute=true
MemoryMax=96M

[Install]
WantedBy=multi-user.target
