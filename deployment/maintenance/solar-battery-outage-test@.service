[Unit]
Description=Run one isolated Influx outage acceptance cycle for %i
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=solar-%i
Group=solar-%i
SupplementaryGroups=solar-config
WorkingDirectory=/opt/solar-battery-forecaster
EnvironmentFile=/etc/solar-battery-forecaster/%i.env
ExecStart=/opt/solar-battery-forecaster/.venv/bin/solar-battery-forecaster %i --config /etc/solar-battery-forecaster/acceptance-outage.yaml --once
UMask=0077
StateDirectory=solar-battery-%i
StateDirectoryMode=0700
ReadWritePaths=/var/lib/solar-battery-%i /run/solar-battery-status/%i
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
MemoryDenyWriteExecute=true
MemoryMax=80M
