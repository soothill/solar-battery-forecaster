[Unit]
Description=Validate Solar Battery Forecaster scope %i
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=solar-%i
Group=solar-%i
SupplementaryGroups=solar-config
WorkingDirectory=/opt/solar-battery-forecaster
EnvironmentFile=/etc/solar-battery-forecaster/%i.env
ExecStart=/opt/solar-battery-forecaster/.venv/bin/solar-battery-forecaster validate --scope %i --config /etc/solar-battery-forecaster/config.yaml
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
MemoryDenyWriteExecute=true
MemoryMax=80M
