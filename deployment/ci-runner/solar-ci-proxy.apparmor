#include <tunables/global>

profile solar-ci-proxy flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>
  #include <abstractions/nameservice>
  network inet stream,
  network inet6 stream,
  /usr/sbin/squid mr,
  /usr/sbin/squid ix,
  /usr/bin/squidclient rix,
  /usr/lib/squid/** rix,
  /lib/** mr,
  /lib64/** mr,
  /etc/squid/** r,
  /run/** rwk,
  /var/spool/squid/** rwk,
  deny /run/docker.sock rw,
  deny /var/run/docker.sock rw,
  deny /proc/sys/** w,
  deny /sys/** w,
}
