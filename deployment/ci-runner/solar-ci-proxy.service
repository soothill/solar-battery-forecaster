[Unit]
Description=Isolated Solar CI HTTPS proxy
Requires=docker.service
After=docker.service network-online.target
Before=solar-ci-runner.service

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=/etc/solar-ci-runner/images.env
ExecStart=/usr/local/libexec/solar-ci-runner/proxy-up.sh
ExecStartPost=/usr/local/libexec/solar-ci-runner/validate-host.sh
ExecStop=/usr/local/libexec/solar-ci-runner/proxy-down.sh
TimeoutStartSec=120
TimeoutStopSec=60
UMask=0077

[Install]
WantedBy=multi-user.target
