# Copy to /etc/solar-battery-forecaster/environment on the LXC and chmod 600.
INFLUX_TOKEN=replace-with-a-token-limited-to-the-solar_planner-bucket
SIGENERGY_HOME_APP_KEY=replace-with-developer-portal-app-key
SIGENERGY_HOME_APP_SECRET=replace-with-developer-portal-app-secret
SIGENERGY_HOME_SYSTEM_ID=replace-with-installation-id

# Optional: required only for authenticated Octopus GraphQL features.
OCTOPUS_HOME_API_KEY=

